# Optional AI vision extraction. Leave disabled for fully local operation.
PHILALENS_VISION_PROVIDER=none
PHILALENS_OPENAI_VISION_MODEL=gpt-4.1-mini
PHILALENS_OPENAI_VISION_DETAIL=high

# Required only when PHILALENS_VISION_PROVIDER=openai.
OPENAI_API_KEY=

# Optional local runtime storage override. Defaults to data/local.
PHILALENS_DATA_DIR=
PHILALENS_MAX_UPLOAD_FILES=120

# Optional stamp detector. Use auto to prefer a local YOLO model when present,
# otherwise fall back to OpenCV. Download the model with:
# python3 scripts/download_stamp_detector.py
PHILALENS_STAMP_DETECTOR=auto
PHILALENS_STAMP_YOLO_MODEL_PATH=
PHILALENS_STAMP_YOLO_CONFIDENCE=0.1
PHILALENS_STAMP_CROP_MARGIN_PERCENT=0.02

# Optional local or remote catalog database.
PHILALENS_CATALOG_DB_URL=

# Optional market data providers.
PHILALENS_MARKET_DATA_PROVIDER=
PHILALENS_MARKET_DATA_API_KEY=
